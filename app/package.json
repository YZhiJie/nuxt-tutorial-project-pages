{
    "name": "nuxt-learnhub",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt build",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "typecheck": "nuxi typecheck",
        "test": "vitest run --exclude 'tests/integration/**'",
        "test:integration": "vitest run tests/integration",
