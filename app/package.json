        "vue": "^3.5.0",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@nuxt/test-utils": "^3.23.0",
        "@pinia/nuxt": "^0.11.0",
        "@types/node": "^22.20.5",
        "@vitest/coverage-v8": "^3.2.7",
        "pinia": "^3.0.0",
        "typescript": "^5.8.0",
        "vitest": "^3.0.0",
        "vue-tsc": "^3.0.0"
    }
}
